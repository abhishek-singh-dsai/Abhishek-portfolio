# Public URL of the deployed site, used for canonical/OG links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional contact-form backend. Without it, the form opens the visitor's email app
# (which needs `personal.email` set in src/data/portfolio.js).
#   Formspree: NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
#   Web3Forms: NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.web3forms.com/submit
#              NEXT_PUBLIC_CONTACT_ACCESS_KEY=your-web3forms-access-key
NEXT_PUBLIC_CONTACT_ENDPOINT=
NEXT_PUBLIC_CONTACT_ACCESS_KEY=

# Build-only: sub-path when hosted at user.github.io/<repo> (the Pages workflow sets this).
BASE_PATH=
